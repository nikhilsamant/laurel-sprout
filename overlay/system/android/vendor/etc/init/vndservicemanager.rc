# Point vndservicemanager at /system/bin/servicemanager: the stock
# /vendor/bin/vndservicemanager CHECK-fails without selinuxfs, which this
# AppArmor-only kernel does not provide. See DEVELOPMENT.md.
service vndservicemanager /system/bin/servicemanager /dev/vndbinder
    class core
    user system
    group system readproc
    writepid /dev/cpuset/system-background/tasks
    shutdown critical
