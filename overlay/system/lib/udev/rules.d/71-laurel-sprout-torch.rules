# Camera flash LED permissions. ayatana-indicator-power writes torch brightness
# as the unprivileged phablet user, but the LED nodes are root:root 0644. Hand
# the candidate torch/switch nodes to group video (phablet is a member). RUN+=
# because udev's GROUP=/MODE= keys do not apply to sysfs attributes. Kept on one
# line: a rule that fails to parse fails silently. See DEVELOPMENT.md (the kernel
# half of the fix is in the kernel tree).
ACTION=="add|change", SUBSYSTEM=="leds", KERNEL=="torch-light0|torch-light1|led:torch_0|led:torch_1|led:switch_0|led:switch_1", RUN+="/bin/chgrp video /sys%p/brightness", RUN+="/bin/chmod 0664 /sys%p/brightness"
