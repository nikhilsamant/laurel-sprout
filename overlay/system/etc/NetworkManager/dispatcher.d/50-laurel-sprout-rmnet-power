#!/bin/sh
# Drop the cellular data path while Wi-Fi is up -- Xiaomi Mi A3 (laurel_sprout).
#
# The modem is pinned for Wi-Fi, but its rmnet data path keeps the SoC awake
# (IPA suspend-IRQ storm). Turn the WWAN radio off when wlan0 comes up, back on
# when Wi-Fi goes away. Uses `nmcli radio wwan`, NOT `ip link` (which leaves
# IPA's HW filter/route rules stale and silently drops packets). Must live in
# dispatcher.d, not no-wait.d (NM never runs no-wait.d on this build). Full
# rationale and measurements in DEVELOPMENT.md.

IFACE="$1"
ACTION="$2"

# Marker must persist like the WWAN flag it tracks: /var/lib/NetworkManager is
# a rw bind-mount from userdata (/run is tmpfs and would not survive a reboot).
MARKER=/var/lib/NetworkManager/laurel-sprout-wwan-off-by-us
LOG=/run/rmnet-power.log

# NM does not reliably surface dispatcher stdout to the journal; log to a file.
log() { echo "$(date '+%H:%M:%S') $*" >>"$LOG" 2>/dev/null; }

log "INVOKED iface=$IFACE action=$ACTION"
[ "$IFACE" = "wlan0" ] || exit 0

# One transient unit name per action, so an up/down overlap cannot collide.
UNIT="laurel-sprout-wwan-$ACTION"

run_detached() {
    systemctl stop "$UNIT" 2>/dev/null
    systemctl reset-failed "$UNIT" 2>/dev/null
    systemd-run --collect --unit="$UNIT" \
        --description="laurel_sprout: Wi-Fi/WWAN power handover ($ACTION)" \
        /bin/sh -c "$1" >>"$LOG" 2>&1
    log "  systemd-run $UNIT rc=$?"
}

case "$ACTION" in
up)
    # Settle, then re-check: a Wi-Fi association that flaps must not leave
    # mobile data switched off behind it.
    run_detached "
        exec >>$LOG 2>&1
        sleep 5
        st=\$(cat /sys/class/net/wlan0/operstate 2>/dev/null)
        [ \"\$st\" = up ] || { echo \"  [up] bail: operstate=\$st\"; exit 0; }
        rd=\$(nmcli radio wwan 2>&1)
        [ \"\$rd\" = enabled ] || { echo \"  [up] bail: wwan=\$rd\"; exit 0; }
        nmcli radio wwan off && touch $MARKER
        echo \"  [up] wwan now=\$(nmcli radio wwan 2>&1)\"
    "
    ;;
down)
    # Only ever re-enable if WE disabled it, so turning mobile data off by hand
    # is not silently undone.
    run_detached "
        exec >>$LOG 2>&1
        [ -e $MARKER ] || { echo '  [down] bail: not disabled by us'; exit 0; }
        nmcli radio wwan on && rm -f $MARKER
        echo \"  [down] wwan now=\$(nmcli radio wwan 2>&1)\"
    "
    ;;
esac

exit 0
