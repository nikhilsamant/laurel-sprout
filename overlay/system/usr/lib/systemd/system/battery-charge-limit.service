# Caps battery charging at a state of charge. Started from device-hacks.
# Config, in increasing precedence: the Environment= defaults below; the
# root-owned EnvironmentFiles (/etc/writable is the one writable on device);
# and ~phablet/.config/battery-charge-limit, re-read by the script every poll
# (the user-facing layer, no root, range 50..100, 100 = off). The user file is
# not an EnvironmentFile on purpose. See DEVELOPMENT.md.

[Unit]
Description=Cap battery charging at a configurable state of charge
Documentation=file:/usr/lib/systemd/system/battery-charge-limit.sh
ConditionPathExists=/sys/class/power_supply/battery/charging_enabled

[Service]
Type=simple
Environment=CHARGE_LIMIT=80
Environment=CHARGE_RESUME=75
Environment=CHARGE_POLL_INTERVAL=30
EnvironmentFile=-/etc/default/battery-charge-limit
EnvironmentFile=-/etc/writable/battery-charge-limit
ExecStart=/usr/lib/systemd/system/battery-charge-limit.sh

# Never leave the charger disabled behind us.
ExecStopPost=/bin/sh -c 'echo 1 > /sys/class/power_supply/battery/charging_enabled'

# on-failure, not always: a clean exit 0 (user switched limiting off) must stick.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
