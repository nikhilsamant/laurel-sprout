# Restarts the charge limiter when its config file changes (this is the "on"
# direction of the settings-page switch; the service polls the file itself for
# "off"). PathChanged + PathModified so both an in-place edit and QSettings'
# atomic rename are caught. See DEVELOPMENT.md.

[Unit]
Description=Watch the charge limiter configuration for changes
Documentation=file:/usr/lib/systemd/system/battery-charge-limit.sh

[Path]
PathChanged=/home/phablet/.config/battery-charge-limit
PathModified=/home/phablet/.config/battery-charge-limit
Unit=battery-charge-limit.service

[Install]
WantedBy=multi-user.target
