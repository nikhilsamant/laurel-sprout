#!/bin/sh
# device-hacks for Xiaomi Mi A3 (laurel_sprout). Run by device-hacks.service
# once the Android container is up. Does three jobs no Ubuntu Touch service
# does: hold the modem (MPSS) up for Wi-Fi, run the graphics composer HAL, and
# stop Android's time_daemon. Full rationale in DEVELOPMENT.md.

SELF=$(readlink -f "$0")

# Re-invoked by systemd-run as the transient halium-modem-wlan.service. Kept
# inline because the only writable dir here (/run) is noexec.
if [ "$1" = "--hold-modem" ]; then
    # The MPSS stays powered exactly as long as fd 9 is held.
    exec 9< /dev/subsys_modem || exit 1

    # Wait for the driver's "WLAN FW is ready" rather than guessing the timing.
    i=0
    while [ "$i" -lt 60 ]; do
        if dmesg | grep -q "WLAN FW is ready"; then
            break
        fi
        sleep 1
        i=$((i + 1))
    done

    i=0
    while [ "$i" -lt 5 ]; do
        if [ -e /sys/class/net/wlan0 ]; then
            break
        fi
        printf 'ON\n' > /dev/wlan 2>/dev/null
        i=$((i + 1))
    done

    # fd 9 survives this exec; closing it would drop the modem again.
    exec sleep infinity
fi

ANDROID_LD=/android/system/lib64:/android/system/lib64/vndk-30
android_setprop() {
    LD_LIBRARY_PATH="$ANDROID_LD" /android/system/bin/linker64 \
        /android/system/bin/setprop "$@" 2>/dev/null
}

# Wait for the container's property service before issuing ctl.* commands.
i=0
while [ ! -S /dev/socket/property_service ] && [ "$i" -lt 30 ]; do
    sleep 1
    i=$((i + 1))
done

# --- Android time_daemon --------------------------------------------------
# It sets the clock from the raw PM6125 RTC counter (epoch+uptime) and undoes
# timekeeper.service's restore. Also overlaid non-executable; this just breaks
# init's restart loop. Same pair as fairphone-fp4/fp5.
android_setprop ctl.stop time_daemon

# --- Battery charge limit -----------------------------------------------------
# Started here rather than enabled. The .path unit goes first; the service exits
# 0 straight away if the switch is off. See battery-charge-limit.{service,sh}.
systemctl start battery-charge-limit.path
systemctl start battery-charge-limit.service

# --- Modem (MPSS) + Wi-Fi ---------------------------------------------------
# Nothing on the UT side boots the modem, and this integrated WCN3990 rides its
# firmware inside the MPSS image, so Wi-Fi (and the rmnet data path) depend on
# it. Runs in its own transient unit: device-hacks.service is oneshot with
# KillMode=control-group, so its cgroup is torn down when this script returns.
if ! systemctl is-active --quiet halium-modem-wlan.service; then
    systemctl reset-failed halium-modem-wlan.service 2>/dev/null
    systemd-run --collect --unit=halium-modem-wlan \
        --description="Halium: hold the MPSS up and start the WLAN driver" \
        --property=Restart=on-failure --property=RestartSec=5 \
        "$SELF" --hold-modem >/dev/null 2>&1
fi

# --- Graphics composer HAL --------------------------------------------------
# WORKAROUND, not a fix. vendor.hwcomposer-2-4 exits 1 under init and never
# registers IComposer, so Mir never gets a display. The same binary with init's
# exact credentials, started from here, works. Remove once the init failure is
# understood.
android_setprop ctl.stop vendor.hwcomposer-2-4
sleep 1

# Own transient unit (see the modem block for why). No LD_LIBRARY_PATH -- this
# is the exact invocation verified to work on-device.
systemctl reset-failed hwcomposer-halium.service 2>/dev/null
systemd-run --collect --unit=hwcomposer-halium \
    --description="Halium workaround: Android graphics composer HAL" \
    --property=Restart=always --property=RestartSec=2 \
    setpriv --reuid 1000 --regid 1003 --groups 1003,1027 \
    /android/system/bin/linker64 \
    /android/vendor/bin/hw/android.hardware.graphics.composer@2.4-service \
    >/dev/null 2>&1

# lightdm is ordered After=device-hacks.service, so block here until the
# composer is up or lomiri-system-compositor can start first and time out.
i=0
while [ "$i" -lt 20 ]; do
    if pgrep -f "graphics\.composer@2\.4-service" >/dev/null 2>&1; then
        sleep 3   # let registerAsService() complete
        break
    fi
    sleep 1
    i=$((i + 1))
done

exit 0
