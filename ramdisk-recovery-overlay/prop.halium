# Read by the recovery's system-image-upgrader on install and every delta OTA.
# 3072 is the exact size of system_a/system_b on this device (static A/B, no
# super partition) -- do NOT raise it, or the upgrader falls into the LVM/super
# path and every OTA fails. Keep in sync with deviceinfo_system_partition_size.
ro.systemimage.system_partition_size=3072
